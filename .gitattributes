*.scala   text eol=lf
*.sc      text eol=lf
*.sbt     text eol=lf
*.yml     text eol=lf
*.md      text eol=lf

# Parity fixtures are read verbatim by both the Scala and Rust tests, and some
# carry line endings AS DATA (csv-parity's crlf.csv and lone-cr.csv exist to pin
# CR handling). `-text` disables eol conversion entirely, so every platform
# checks out the committed bytes — `text eol=lf` would normalize the very bytes
# under test, and no rule at all let autocrlf=true CI runners mangle them (the
# Windows-CI CsvParitySuite failures).
test-data/** -text
build.sbt binary
